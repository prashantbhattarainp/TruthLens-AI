{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truthlens.ai/contracts/prediction-response.schema.json",
  "title": "TruthLens Prediction Response Data",
  "description": "The data payload returned inside the standardized successful response from POST /api/predict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction",
    "confidence",
    "risk_level",
    "explanation",
    "keywords",
    "processing_time_ms",
    "model",
    "model_version",
    "dataset_version"
  ],
  "properties": {
    "prediction": {
      "type": "string",
      "enum": ["Real", "Fake"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "reasons"],
      "properties": {
        "summary": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "dataset_version": {
      "type": "string"
    }
  }
}
